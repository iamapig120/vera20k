+/// Only present to the host on a successful frame hand-off, and only on
+/// transitions. A rejected browser action can keep the fallback visible
+/// without a later frame hiding it again.
+pub(crate) fn report_battlefield_fullscreen(visible: bool) {
+    thread_local! {
+        static REPORTED: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    }
+    if REPORTED.with(|reported| reported.replace(visible)) == visible {
+        return;
+    }
+    if let Some(report) = js_sys::Reflect::get(
+        &js_sys::global(),
+        &"vera20kBattlefieldFullscreenAvailability".into(),
