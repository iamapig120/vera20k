@@ -0,0 +1,65 @@
+const assert = require('node:assert/strict');
+const {readFileSync} = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const test = require('node:test');
+
+function fixture(hasRa2Export = true) {
+    const elements = new Map();
+    function element(key) {
+        if (!elements.has(key)) elements.set(key, {
+            textContent: '', hidden: false, dataset: {}, style: {}, firstElementChild: {style: {}},
+            classList: {add() {}, remove() {}, toggle() {}},
+            addEventListener() {}, setAttribute() {}, focus() {}, closest: () => ({}),
+        });
+        return elements.get(key);
+    }
+    const calls = [];
+    const context = vm.createContext({
+        document: {documentElement: {}, querySelector: element, querySelectorAll: () => []},
+        navigator: {language: 'en'}, localStorage: {getItem: () => 'en'},
+        window: {}, setTimeout() {}, Uint8Array,
+        import_file: (name) => calls.push(name),
+        prepare_audio: () => calls.push('audio'),
+        fonts_ready: async () => calls.push('fonts'),
+        start_game: () => calls.push('YR'),
+        engine: hasRa2Export ? {start_ra2: () => calls.push('RA2')} : {},
+    });
+    let source = readFileSync(path.join(__dirname, '../host.js'), 'utf8')
+        .replace(/\r\n/g, '\n').replace(/^import .*\n/gm, '');
+    source = source.slice(0, source.indexOf('try {\n    await init();'));
+    vm.runInContext(source + '\nglobalThis.api = {choose, launch};', context);
+    const files = names => names.map(name => [name, {
+        size: 1, arrayBuffer: async () => new ArrayBuffer(1),
+    }]);
+    return {files, choose: context.api.choose, launch: context.api.launch, calls, element};
+}
+
+test('YR is still the primary entry and does not import the RA2 map archive', async () => {
+    const f = fixture();
+    f.choose(f.files(['retail/ra2md.mix', 'retail/RA2.MIX', 'retail/language.mix', 'retail/multi.mix']));
+    assert.equal(f.element('#start').disabled, false);
+    assert.equal(f.element('#start-ra2').hidden, false);
+    await f.launch();
+    assert.deepEqual(f.calls, ['audio', 'ra2md.mix', 'RA2.MIX', 'language.mix', 'fonts', 'YR']);
+});
+
+test('the optional entry launches real RA2, including its map archive, only once', async () => {
+    const f = fixture();
+    f.choose(f.files(['retail/ra2md.mix', 'retail/RA2.MIX', 'retail/language.mix', 'retail/MULTI.MIX']));
+    await Promise.all([f.launch(true), f.launch(false)]);
+    assert.deepEqual(f.calls, ['audio', 'ra2md.mix', 'RA2.MIX', 'language.mix', 'MULTI.MIX', 'fonts', 'RA2']);
+});
+
+test('YR-only resources and older engines do not present an inert RA2 entry', async () => {
+    for (const [exported, names] of [[true, ['ra2md.mix', 'not-the-game/ra2.mix']], [true, ['ra2md.mix', 'ra2.mix', 'language.mix']], [false, ['ra2md.mix', 'ra2.mix', 'language.mix', 'multi.mix']]]) {
+        const f = fixture(exported);
+        f.choose(f.files(names));
+        assert.equal(f.element('#start-ra2').hidden, true);
+        assert.equal(f.element('#start-ra2').disabled, true);
+        await f.launch(true);
+        assert.deepEqual(f.calls, []);
+        await f.launch();
+        assert.equal(f.calls.at(-1), 'YR');
+    }
+});
