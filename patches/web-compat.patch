+// Browser files live in one synchronous VFS. Shared leases replace process file
+// locks: no JS callback can interleave eviction and publication within a call.
+#[cfg(target_arch = "wasm32")]
+impl Cache {
+    pub fn open(directory: &Path, _create: bool, limits: Limits) -> Result<Self> {
+        Ok(Self {
+            directory: directory.to_path_buf(),
+            limits,
+        })
+    }
+
+    pub fn path(&self, digest: &str, resource: TransferResource) -> Result<PathBuf> {
+        let path = self
+            .directory
+            .join(format!("{digest}.{}", resource.extension()));
+        match crate::util::file_system::metadata(&path) {
+            Ok(metadata) => ensure!(
+                metadata.is_file(),
+                "network cache destination is not a regular file"
+            ),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error.into()),
+        }
+        Ok(path)
+    }
+
+    pub fn pin(&self, path: &Path) -> Result<CacheLease> {
+        let mut pins = pins().lock().unwrap();
+        pins.retain(|_, weak| weak.strong_count() != 0);
+        let pin = pins
+            .get(path)
+            .and_then(std::sync::Weak::upgrade)
+            .unwrap_or_else(|| {
+                let pin = Arc::new(path.to_path_buf());
+                pins.insert(path.to_path_buf(), Arc::downgrade(&pin));
+                pin
+            });
+        Ok(CacheLease(Some(pin)))
+    }
+
+    pub fn directory(&self) -> &Path {
+        &self.directory
+    }
+
+    pub fn make_room(&self, destination: &Path, incoming: usize) -> Result<()> {
+        use crate::util::file_system as fs;
+        ensure!(
+            incoming as u64 <= self.limits.bytes,
+            "network map exceeds cache quota"
+        );
+        let mut files = usize::from(incoming != 0);
+        let mut bytes = incoming as u64;
+        let mut entries = Vec::new();
+        let listing = match fs::read_dir(&self.directory) {
+            Ok(entries) => Some(entries),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => None,
+            Err(error) => return Err(error.into()),
+        };
+        for item in listing.into_iter().flatten() {
+            let item = item?;
+            let metadata = item.metadata()?;
+            if !metadata.is_file() {
+                continue;
+            }
+            files += 1;
+            bytes = bytes
+                .checked_add(metadata.len())
+                .ok_or_else(|| anyhow::anyhow!("network cache size overflow"))?;
+            let name = item.file_name();
+            let Some((digest, resource)) = entry_name(name.to_str().unwrap_or("")) else {
+                continue;
+            };
+            entries.push(Entry {
+                path: item.path(),
+                digest: digest.to_owned(),
+                length: metadata.len(),
+                modified: metadata.modified().unwrap_or(SystemTime::UNIX_EPOCH),
+                resource,
+            });
+        }
+        entries.sort_by(|a, b| (a.modified, &a.path).cmp(&(b.modified, &b.path)));
+        for entry in entries {
+            if files <= self.limits.files && bytes <= self.limits.bytes {
+                break;
+            }
+            if entry.path == destination || entry.length > entry.resource.limit() as u64 {
+                continue;
+            }
+            if pins()
+                .lock()
+                .unwrap()
+                .get(&entry.path)
+                .is_some_and(|pin| pin.strong_count() != 0)
+            {
+                continue;
+            }
+            let contents = fs::read_shared(&entry.path)?;
+            if contents.len() as u64 != entry.length
+                || crate::util::sha256::sha256_hex(&contents) != entry.digest
+            {
+                continue;
+            }
+            fs::remove_file(&entry.path)?;
+            bytes -= entry.length;
+            files -= 1;
+        }
+        ensure!(
+            files <= self.limits.files && bytes <= self.limits.bytes,
+            "network map cache is full; active or unrecognized files are retained"
+        );
+        Ok(())
+    }
+}
