+/// Product policy for this branch. This is intentionally not retail behavior.
+/// Standard remains the default for desktop and ordinary Web launches.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub enum MainMenuProfile {
+    #[default]
+    Standard,
+    ToySinglePlayer,
+}
+
+impl MainMenuProfile {
+    pub fn allows_action(self, action: MainMenuShellAction) -> bool {
+        self == Self::Standard
+            || !matches!(action, MainMenuShellAction::WwOnline | MainMenuShellAction::Network)
+    }
+
+    pub fn allows_control(self, control: MainMenuControlId) -> bool {
+        self.allows_action(action_for_control(control))
+    }
+
+    pub fn top_button_count(self) -> u32 {
+        match self {
+            Self::Standard => 5,
+            Self::ToySinglePlayer => 3,
+        }
+    }
+}
