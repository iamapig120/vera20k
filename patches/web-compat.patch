+impl MainMenuShellLayout {
+    /// Filter the shared paint/input geometry, then compact the surviving top
+    /// buttons into the original rows. Exit keeps its bottom anchor.
+    pub fn with_profile(mut self, profile: super::MainMenuProfile) -> Self {
+        let rows: Vec<_> = self.buttons.iter().map(|button| button.rect).collect();
+        self.buttons
+            .retain(|button| profile.allows_control(button.id));
+        for (row, button) in self.buttons.iter_mut().enumerate() {
+            if button.id != MainMenuControlId::ExitGame0x3ee {
+                button.rect = rows[row];
+            }
+        }
+        self
+    }
+}
