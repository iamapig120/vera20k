 //! cases cover Allied, Soviet and Yuri at 640x480, 800x600 and 1024x768.
 
 use super::geom::RectPx;
+
+#[cfg(test)]
+mod background_size_tests {
+    use super::{InGameShellLayout, InGameShellSizes};
+
+    fn sizes() -> InGameShellSizes {
+        InGameShellSizes {
+            background_small: [472, 448],
+            background_medium: [632, 568],
+            background_large: [856, 736],
+            credits: [168, 24],
+            top: [168, 8],
+            radar: [168, 112],
+            side1: [168, 8],
+            side2: [168, 8],
+            side3: [168, 8],
+            addon: [168, 8],
+            bottom_spacer: [8, 32],
+            left_cap: [8, 32],
+            button_background: [8, 32],
+            right_cap: [8, 32],
+        }
+    }
+
+    #[test]
+    fn stock_background_sizes_are_preserved() {
+        for (width, height, expected) in [
+            (640, 480, [472, 448]),
+            (800, 600, [632, 568]),
+            (1024, 768, [856, 736]),
+        ] {
+            let rect = InGameShellLayout::new(width, height, sizes())
+                .unwrap()
+                .background;
+            assert_eq!([rect.w, rect.h], expected);
+        }
+    }
+
+    #[test]
+    fn resizing_does_not_jump_to_an_oversized_background() {
+        for (width, height, expected) in [
+            (639, 480, [472, 448]),
+            (641, 600, [472, 448]),
+            (760, 600, [472, 448]),
+            (799, 600, [472, 448]),
+            (800, 599, [472, 448]),
+            (801, 600, [632, 568]),
+            (1023, 768, [632, 568]),
+            (1024, 767, [632, 568]),
+            (1025, 768, [856, 736]),
+        ] {
+            let rect = InGameShellLayout::new(width, height, sizes())
+                .unwrap()
+                .background;
+            assert_eq!([rect.w, rect.h], expected, "{width}x{height}");
+        }
+    }
+
+    #[test]
+    fn background_fit_uses_loaded_theme_dimensions() {
+        let mut art = sizes();
+        art.background_medium = [590, 560];
+        let rect = InGameShellLayout::new(760, 600, art).unwrap().background;
+        assert_eq!([rect.w, rect.h], [590, 560]);
+    }
+}
 
