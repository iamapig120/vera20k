+/// Window command uses the same binding owner, before ordinary game dispatch.
+#[cfg(all(feature = "wasm", target_arch = "wasm32"))]
+pub(crate) fn window_key(state: &mut AppState, event: &KeyEvent) -> bool {
+    use crate::app::input::precedence::{InputLayer, ModalPage, ScreenPage};
+    let allowed = match crate::app::input::precedence::input_layer(state) {
+        InputLayer::Page(ModalPage::Keyboard) => state.frontend.keyboard_dialog.as_ref()
+            .is_some_and(|dialog| !dialog.capture_focused),
+        InputLayer::Screen(ScreenPage::MainMenu | ScreenPage::SinglePlayer |
+            ScreenPage::MoviesAndCredits | ScreenPage::MovieList | ScreenPage::Campaign |
+            ScreenPage::LauncherOptions | ScreenPage::Battlefield) => true,
+        InputLayer::Screen(ScreenPage::InGameShell(
+            crate::ui::pause_menu::InGameMenuState::Menu |
+            crate::ui::pause_menu::InGameMenuState::Options |
+            crate::ui::pause_menu::InGameMenuState::Sound |
+            crate::ui::pause_menu::InGameMenuState::MissionBriefing |
+            crate::ui::pause_menu::InGameMenuState::Diplomacy
+        )) => true,
+        // Text-entry pages and transitions keep ownership of their keys.
+        _ => false,
+    };
+    if !allowed || state.match_state.match_presentation.message_list.editing() {
+        return false;
+    }
+    let unmodified = event.key_without_modifiers();
+    let key = hotkeys::binding_logical_key(&event.logical_key, &unmodified, event.location);
+    if state.match_state.input.hotkey_bindings.resolve_event(
+        key, event.location, state.platform.live_modifiers,
+    ) != hotkeys::HotkeyResolution::Command(hotkeys::HotkeyCommand::ToggleFullscreen) {
+        return false;
+    }
+    if event.state.is_pressed() && !event.repeat {
+        crate::web::toggle_fullscreen();
+    }
+    true
+}
