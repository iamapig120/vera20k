+    fn toy_menu_filters_paint_input_and_keeps_single_player() {
+        let profile = MainMenuProfile::ToySinglePlayer;
+        for layout in [compute_layout(800, 600), compute_responsive_layout(1366, 768)] {
+            let rows: Vec<_> = layout.buttons.iter().map(|button| button.rect).collect();
+            let toy = layout.clone().with_profile(profile);
+            assert_eq!(toy.buttons.iter().map(|button| button.id).collect::<Vec<_>>(), vec![
+                MainMenuControlId::SinglePlayer0x683, MainMenuControlId::MoviesAndCredits0x686,
+                MainMenuControlId::Options0x55c, MainMenuControlId::ExitGame0x3ee,
+            ]);
+            assert_eq!(toy.buttons[1].rect, rows[1]);
+            assert_eq!(toy.buttons[2].rect, rows[2]);
+            assert_eq!(toy.buttons[3].rect, rows[5]);
+            let feed: Vec<_> = toy.buttons.iter().map(|b| LaidOutControl { id: b.id.resource_id(), rect: b.rect }).collect();
+            let mut controller = DialogController::default();
+            controller.ensure_active(MAIN_MENU_DIALOG, false);
+            // Former lower rows are now blank, not invisible click targets.
+            for rect in &rows[3..5] {
+                controller.on_pointer_move(rect.x + 1, rect.y + 1, &feed);
+                controller.on_pointer_down(rect.x + 1, rect.y + 1, &feed);
+                assert_eq!(controller.hovered(), None);
+                assert_eq!(controller.on_pointer_up(rect.x + 1, rect.y + 1, &feed), None);
+            }
+            let rect = toy.buttons[0].rect;
+            controller.on_pointer_down(rect.x + 1, rect.y + 1, &feed);
+            assert_eq!(controller.on_pointer_up(rect.x + 1, rect.y + 1, &feed), Some(0x0683));
+            // This pinned main menu has no keyboard registration or focus list.
+            assert!(controller.kbd_route().is_empty());
+            assert!(!controller.on_key(ShellKey::Tab));
+            assert!(!controller.on_key(ShellKey::Enter));
+            assert_eq!(layout.clone().with_profile(MainMenuProfile::default()), layout);
+        }
