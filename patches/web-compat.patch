+    pub fn admit_initial_library(&mut self, next: Self) -> Result<(), AssetError> {
+        let fail = |detail: &str| AssetError::ParseError {
+            format: "initial resource stage".into(),
+            detail: detail.to_owned(),
+        };
+        if self.active_theater.is_some() || self.ini_roots != next.ini_roots {
+            return Err(fail(
+                "resource stage must precede theater activation and keep the INI roots",
+            ));
+        }
+        for name in [
+            self.ini_roots.rules(),
+            self.ini_roots.art(),
+            self.ini_roots.ai(),
+            self.ini_roots.sound(),
+            self.ini_roots.eva(),
+        ] {
+            if self.get_ref(name) != next.get_ref(name) {
+                return Err(fail("resource stage changed a process definition"));
+            }
+        }
+        let cache = self
+            .mix_file_cache
+            .lock()
+            .unwrap_or_else(|p| p.into_inner());
+        for (id, cached) in cache.iter() {
+            let loose = next.loose_files.values().find(|loose| {
+                loose
+                    .source_name
+                    .eq_ignore_ascii_case(&cached.source_archive)
+            });
+            let candidate = if let Some(loose) = loose {
+                loose.bytes()
+            } else {
+                next.lookup_index.get(id).and_then(|where_| {
+                    let archive = &next.archives[where_.archive_index];
+                    archive
+                        .name
+                        .eq_ignore_ascii_case(&cached.source_archive)
+                        .then(|| archive.archive.get_by_id(*id))
+                        .flatten()
+                })
+            };
+            if candidate != Some(cached.bytes.as_ref()) {
+                return Err(fail("resource stage changed a sticky file winner"));
+            }
+        }
+        drop(cache);
+        self.archives = next.archives;
+        self.archive_catalog = next.archive_catalog;
+        self.lookup_index = next.lookup_index;
+        self.loose_files = next.loose_files;
+        self.audio_pairs = next.audio_pairs;
+        Ok(())
+    }
+
+    /// Existing leaf data may not change when a bootstrap archive is completed.
+    pub fn validate_archive_expansion(
+        previous: Arc<[u8]>,
+        complete: Arc<[u8]>,
+    ) -> Result<(), AssetError> {
+        fn check(old: &MixArchive, full: &MixArchive, depth: usize) -> Result<(), AssetError> {
+            if depth > 8 {
+                return Err(AssetError::InvalidMixHeader {
+                    reason: "resource stage nesting exceeds eight levels".into(),
+                });
+            }
+            for entry in old.entries() {
+                let Some(next) = full.get_by_id(entry.id) else {
+                    return Err(AssetError::InvalidMixHeader {
+                        reason: "stage removed a bootstrap member".into(),
+                    });
+                };
+                let Some(bytes) = old.get_by_id(entry.id) else {
+                    return Err(AssetError::InvalidMixHeader {
+                        reason: "invalid bootstrap member bounds".into(),
+                    });
+                };
+                if KNOWN_NESTED_MIX_NAMES
+                    .iter()
+                    .any(|name| mix_hash(name) == entry.id)
+                {
+                    check(
+                        &MixArchive::from_bytes(bytes.to_vec())?,
+                        &MixArchive::from_bytes(next.to_vec())?,
+                        depth + 1,
+                    )?;
+                } else if bytes != next {
+                    return Err(AssetError::InvalidMixHeader {
+                        reason: "stage changed a bootstrap member".into(),
+                    });
+                }
+            }
+            Ok(())
+        }
+        check(
