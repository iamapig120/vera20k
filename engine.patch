+/// Newly authored indexed glyph following the approved outward four-corner
+/// silhouette. Draw it over the active side's decoded BTTNBKGD.SHP, so no
+/// retail plate or palette bytes ship with the extension. One glyph serves
+/// both enter and exit; controller state never selects different art.
+fn fullscreen_glyph(theme: SidebarTheme) -> RenderedChromeEntry {
+    const W: usize = 22;
+    const H: usize = 15;
+    const CORNER: [[u8; 6]; 5] = [
+        [0, 0, 2, 2, 2, 1],
+        [0, 3, 3, 2, 1, 0],
+        [2, 3, 2, 0, 0, 0],
+        [2, 2, 1, 0, 0, 0],
+        [1, 2, 0, 0, 0, 0],
+    ];
+    let colors: [[u8; 4]; 4] = match theme {
+        SidebarTheme::Allied => [
+            [0, 0, 0, 0],
+            [29, 85, 140, 255],
+            [61, 151, 227, 255],
+            [132, 216, 253, 255],
+        ],
+        SidebarTheme::Soviet | SidebarTheme::Yuri => [
+            [0, 0, 0, 0],
+            [130, 77, 8, 255],
+            [218, 148, 34, 255],
+            [255, 216, 111, 255],
+        ],
+    };
+    let mut indices = vec![0; W * H];
+    for (y, row) in CORNER.iter().enumerate() {
+        for (x, &shade) in row.iter().enumerate() {
+            for py in [y, H - 1 - y] {
+                for px in [x, W - 1 - x] {
+                    indices[py * W + px] = shade;
+                }
+            }
+        }
+    }
+    let rgba = indices
+        .iter()
+        .flat_map(|&i| colors[usize::from(i)])
+        .collect();
+    RenderedChromeEntry {
+        rgba,
+        indices,
+        width: W as u32,
+        height: H as u32,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn fullscreen_glyph_has_four_open_corners_and_side_colors() {
+        let blue = fullscreen_glyph(SidebarTheme::Allied);
+        let gold = fullscreen_glyph(SidebarTheme::Soviet);
+        let yuri = fullscreen_glyph(SidebarTheme::Yuri);
+        let (w, h) = (blue.width as usize, blue.height as usize);
+        let index = |x, y| y * w + x;
+        assert_eq!((w, h), (22, 15));
+        assert_eq!(blue.indices, gold.indices);
+        assert_eq!(gold.rgba, yuri.rgba);
+        assert_ne!(blue.rgba, gold.rgba);
+        for y in [1, h - 2] {
+            for x in [1, w - 2] {
+                let i = index(x, y) * 4;
+                assert_eq!(blue.rgba[i + 3], 255);
+                assert!(blue.rgba[i + 2] > blue.rgba[i]);
+                assert!(gold.rgba[i] > gold.rgba[i + 2]);
+            }
+        }
+        for (x, y) in [(w / 2, 0), (0, h / 2), (w / 2, h / 2)] {
+            assert_eq!(blue.rgba[index(x, y) * 4 + 3], 0);
+        }
+    }
+}
